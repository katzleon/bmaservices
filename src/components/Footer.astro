---
const currentYear = new Date().getFullYear();
---

<footer class="bg-white text-gray border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Main footer content -->
    <div class="py-16 grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Logo & About -->
      <div>
        <img
          src="/images/logo.png"
          alt="BMA Services logo"
          class="h-14 w-auto mb-6"
        />
        <p class="text-gray-500 text-sm leading-relaxed">
          Complete artist handling voor evenementen en festivals. Al sinds 2001 dé specialist in artiestenvervoer en stagemanagement in Nederland.
        </p>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-lg font-bold mb-6 text-dark">Contact</h3>
        <ul class="space-y-3 text-gray-500 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-primary mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Zuid Afrikaweg 12 F<br />1432 DA Aalsmeer</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:+31650504980" class="hover:text-primary transition-colors">+31 (0)6 50 50 49 80</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@bmaservices.nl" class="hover:text-primary transition-colors">info@bmaservices.nl</a>
          </li>
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-lg font-bold mb-6 text-dark">Links</h3>
        <ul class="space-y-3 text-gray-500 text-sm">
          <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
          <li><a href="/services" class="hover:text-primary transition-colors">Services</a></li>
          <li><a href="/klanten" class="hover:text-primary transition-colors">Klanten</a></li>
          <li><a href="/over-ons" class="hover:text-primary transition-colors">Over ons</a></li>
          <li><a href="/contact" class="hover:text-primary transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-gray-100 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-gray-400 text-sm">&copy; {currentYear} BMA Services. Alle rechten voorbehouden.</p>
      <a
        href="/Algemene-voorwaarden-BMA-Services.pdf"
        class="text-gray-400 text-sm hover:text-primary transition-colors"
        target="_blank"
        rel="noopener noreferrer"
      >
        Algemene voorwaarden
      </a>
    </div>
  </div>
</footer>
