---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    title: 'Complete Artist Handling',
    description: 'Van aankomst tot vertrek begeleiden wij uw artiesten op professionele wijze. Wij nemen de volledige artisthandling uit handen, zodat u zich kunt focussen op de organisatie van uw evenement.',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
  },
  {
    title: 'Artiestenvervoer',
    description: 'Betrouwbaar en luxe vervoer voor artiesten van en naar locaties, luchthavens en hotels. Onze ervaren chauffeurs kennen de weg en zorgen dat uw artiesten altijd op tijd zijn.',
    icon: 'M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4',
  },
  {
    title: 'Stagemanagement',
    description: 'Professioneel stagemanagement dat ervoor zorgt dat alles op en rond het podium soepel verloopt. Onze stagemanagers coördineren alle technische en logistieke aspecten.',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    title: 'Assistent-Stagemanagers',
    description: 'Onze assistent-stagemanagers ondersteunen het stagemanagement bij grotere evenementen. Ze zorgen voor een naadloze communicatie tussen alle betrokken partijen.',
    icon: 'M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z',
  },
  {
    title: 'Stagehands',
    description: 'Ervaren stagehands die helpen bij het op- en afbouwen van podia, het verplaatsen van apparatuur en het ondersteunen van de technische crew tijdens evenementen.',
    icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z',
  },
  {
    title: 'Artiestenopvang',
    description: 'Professionele opvang van artiesten op festivals en op Schiphol. Wij zorgen voor een warme ontvangst en een soepele overgang naar de locatie van het evenement.',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
  },
  {
    title: 'Hostess Service',
    description: 'Professionele hostessen die artiesten en gasten verwelkomen en begeleiden. Zij zorgen voor een gastvrije sfeer en staan klaar om aan alle wensen te voldoen.',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
  },
  {
    title: 'Shuttle Service',
    description: 'Efficiënte shuttleservice voor het vervoer van artiesten, crew en gasten tussen verschillende locaties. Altijd op tijd, altijd betrouwbaar.',
    icon: 'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0',
  },
  {
    title: 'Private Jet Bemiddeling',
    description: 'Voor internationale artiesten bieden wij bemiddeling bij het regelen van privéjets. Wij zorgen voor een naadloze reis van en naar uw evenement.',
    icon: 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8',
  },
];
---

<Layout title="Services - BMA Services">
  <Header />

  <HeroSection
    title="Onze Services"
    subtitle="Complete artist handling | Artiestenvervoer | Stagemanagement"
    tagline="Artist Handling"
    backgroundImage="/images/festival-dancer.jpg"
  />

  <!-- Services intro -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-dark mb-6">
          Alles voor uw artiesten, onder één dak
        </h2>
        <p class="text-lg text-gray-500 leading-relaxed">
          BMA Services is gespecialiseerd in de complete artisthandling van artiesten op feesten en festivals. Alle aspecten die bij de artiestenproductie horen kunnen wij regelen.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service) => (
          <div class="group bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-xl hover:border-primary/20 transition-all duration-300 hover:-translate-y-1">
            <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
              <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon} />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-dark mb-3">{service.title}</h3>
            <p class="text-gray-500 leading-relaxed text-sm">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Transport showcase -->
  <section class="py-20 bg-gray-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <p class="text-primary font-semibold text-sm tracking-widest uppercase mb-3">Artiestenvervoer</p>
        <h2 class="text-3xl md:text-4xl font-bold text-dark">Comfortabel & Op Tijd</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="group rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300">
          <div class="relative h-56 overflow-hidden">
            <img src="/images/sedan-interior.jpg" alt="Luxe interieur van een sedan gebruikt voor artiestenvervoer" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="bg-white p-5">
            <h3 class="font-bold text-dark">VIP Vervoer</h3>
            <p class="text-gray-500 text-sm mt-1">Comfortabel vervoer van en naar locaties</p>
          </div>
        </div>
        <div class="group rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300">
          <div class="relative h-56 overflow-hidden">
            <img src="/images/chauffeur-service.jpg" alt="Professionele chauffeur opent de deur van een voertuig voor een artiest" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="bg-white p-5">
            <h3 class="font-bold text-dark">Ervaren Drivers</h3>
            <p class="text-gray-500 text-sm mt-1">Onze drivers kennen de weg en zijn altijd op tijd</p>
          </div>
        </div>
        <div class="group rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300">
          <div class="relative h-56 overflow-hidden">
            <img src="/images/shuttle-interior.jpg" alt="Interieur van een shuttle bus voor groepsvervoer van artiesten en crew" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="bg-white p-5">
            <h3 class="font-bold text-dark">Shuttle Service</h3>
            <p class="text-gray-500 text-sm mt-1">Groepsvervoer tussen locaties, hotels en luchthavens</p>
          </div>
        </div>
        <div class="group rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-shadow duration-300">
          <div class="relative h-56 overflow-hidden">
            <img src="/images/luxury-transport.jpg" alt="Luxe auto naast een privéjet op een luchthaven" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="bg-white p-5">
            <h3 class="font-bold text-dark">Private Jet Bemiddeling</h3>
            <p class="text-gray-500 text-sm mt-1">Wij regelen privéjets voor internationale artiesten</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-primary font-semibold text-sm tracking-widest uppercase mb-3">Waarom BMA Services</p>
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
            Meer dan 20 jaar ervaring in artist handling
          </h2>
          <p class="text-gray-400 leading-relaxed mb-8">
            Sinds 2001 zijn wij dé specialist in complete artist handling voor de grootste festivals en evenementen van Nederland. Ons ervaren team weet precies wat er nodig is om uw artiesten professioneel te begeleiden.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-300">Ervaren en professioneel team</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-300">24/7 bereikbaar en beschikbaar</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-300">Flexibel en op maat gemaakte oplossingen</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-gray-300">Vertrouwd door de grootste namen in de branche</span>
            </li>
          </ul>
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
            <div class="text-3xl font-black text-primary mb-2">20+</div>
            <div class="text-gray-400 text-sm">Jaar Ervaring</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
            <div class="text-3xl font-black text-primary mb-2">30+</div>
            <div class="text-gray-400 text-sm">Vaste Klanten</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
            <div class="text-3xl font-black text-primary mb-2">500+</div>
            <div class="text-gray-400 text-sm">Evenementen</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center">
            <div class="text-3xl font-black text-primary mb-2">24/7</div>
            <div class="text-gray-400 text-sm">Beschikbaar</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-6">
        Interesse in onze services?
      </h2>
      <p class="text-lg text-gray-500 mb-10 max-w-2xl mx-auto">
        Neem vrijblijvend contact met ons op om de mogelijkheden te bespreken. Wij denken graag met u mee over de perfecte artist handling voor uw evenement.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:shadow-lg hover:shadow-primary/25"
      >
        Neem contact op
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <ClientLogos compact />

  <Footer />
</Layout>
