---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="BMA Services - Artist Support voor Evenementen">
  <Header />

  <HeroSection
    title="Artist Support voor Evenementen"
    subtitle="Complete artist handling | Artiestenvervoer | Stagemanagement"
    tagline="Sinds 2001"
    showCta={true}
    large={true}
    backgroundImage="/images/concert-lights.jpg"
  />

  <!-- Services overview -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <p class="text-primary font-semibold text-sm tracking-widest uppercase mb-3">Wat wij doen</p>
        <h2 class="text-3xl md:text-4xl font-bold text-dark">Professionele Artist Handling</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div class="group bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-xl hover:border-primary/20 transition-all duration-300 hover:-translate-y-1">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Gecertificeerde Experts</h3>
          <p class="text-gray-500 leading-relaxed">
            Met meer dan 20 jaar ervaring in de evenementenbranche beschikken wij over een team van gecertificeerde professionals die elke situatie aankunnen.
          </p>
        </div>

        <!-- Card 2 -->
        <div class="group bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-xl hover:border-primary/20 transition-all duration-300 hover:-translate-y-1">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Kwaliteitsservice</h3>
          <p class="text-gray-500 leading-relaxed">
            Wij leveren service van het hoogste niveau. Van artiestenvervoer tot complete stagemanagement, elk detail wordt met zorg behandeld.
          </p>
        </div>

        <!-- Card 3 -->
        <div class="group bg-white border border-gray-100 rounded-2xl p-8 hover:shadow-xl hover:border-primary/20 transition-all duration-300 hover:-translate-y-1">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-primary/20 transition-colors">
            <svg class="w-7 h-7 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-3">Scherpe Tarieven</h3>
          <p class="text-gray-500 leading-relaxed">
            Professionele service hoeft niet duur te zijn. Wij bieden concurrerende tarieven zonder concessies te doen aan kwaliteit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Image showcase -->
  <section class="py-0">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-0">
      <div class="relative h-72 overflow-hidden group">
        <img src="/images/awakenings-event.jpg" alt="Awakenings Festival met confetti en publiek tijdens nieuwjaarsevenement" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute inset-0 bg-dark/40 group-hover:bg-dark/20 transition-colors duration-300"></div>
        <div class="absolute bottom-6 left-6 text-white">
          <p class="text-sm font-semibold text-primary">Festivals</p>
          <p class="text-lg font-bold">Awakenings</p>
        </div>
      </div>
      <div class="relative h-72 overflow-hidden group">
        <img src="/images/mysteryland-stage.jpg" alt="Mysteryland Festival podium met indrukwekkend decor en publiek" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute inset-0 bg-dark/40 group-hover:bg-dark/20 transition-colors duration-300"></div>
        <div class="absolute bottom-6 left-6 text-white">
          <p class="text-sm font-semibold text-primary">Evenementen</p>
          <p class="text-lg font-bold">Mysteryland</p>
        </div>
      </div>
      <div class="relative h-72 overflow-hidden group">
        <img src="/images/dj-festival.png" alt="DJ aan het draaien op een festival gezien vanaf achter de draaitafels" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute inset-0 bg-dark/40 group-hover:bg-dark/20 transition-colors duration-300"></div>
        <div class="absolute bottom-6 left-6 text-white">
          <p class="text-sm font-semibold text-primary">Artist Handling</p>
          <p class="text-lg font-bold">Stagemanagement</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats section -->
  <section class="py-20 bg-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div>
          <div class="text-4xl md:text-5xl font-black text-primary mb-2">20+</div>
          <div class="text-gray-400 text-sm font-medium uppercase tracking-wider">Jaar Ervaring</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-black text-primary mb-2">30+</div>
          <div class="text-gray-400 text-sm font-medium uppercase tracking-wider">Vaste Klanten</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-black text-primary mb-2">500+</div>
          <div class="text-gray-400 text-sm font-medium uppercase tracking-wider">Evenementen</div>
        </div>
        <div>
          <div class="text-4xl md:text-5xl font-black text-primary mb-2">24/7</div>
          <div class="text-gray-400 text-sm font-medium uppercase tracking-wider">Beschikbaar</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-dark mb-6">
        Klaar voor professionele artist handling?
      </h2>
      <p class="text-lg text-gray-500 mb-10 max-w-2xl mx-auto">
        Of het nu gaat om een festival, evenement of clubavond: wij zorgen ervoor dat uw artiesten professioneel worden begeleid van aankomst tot vertrek.
      </p>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-4 rounded-full transition-all duration-300 hover:shadow-lg hover:shadow-primary/25"
      >
        Neem contact op
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <ClientLogos />

  <Footer />
</Layout>
