---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact - BMA Services">
  <Header />

  <HeroSection
    title="Contact"
    subtitle="Neem gerust contact met ons op voor al uw vragen over artist handling"
    tagline="Artist Handling"
    backgroundImage="/images/dj-festival.png"
  />

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Contact Info -->
        <div>
          <p class="text-primary font-semibold text-sm tracking-widest uppercase mb-3">Neem contact op</p>
          <h2 class="text-3xl md:text-4xl font-bold text-dark mb-6">
            Wij staan voor u klaar
          </h2>
          <p class="text-gray-500 leading-relaxed mb-10">
            Heeft u vragen over onze services of wilt u een vrijblijvende offerte ontvangen? Neem gerust contact met ons op. Wij reageren zo snel mogelijk op uw bericht.
          </p>

          <div class="space-y-6">
            <!-- Phone -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-dark mb-1">Telefoon</h3>
                <a href="tel:+31650504980" class="text-gray-500 hover:text-primary transition-colors">
                  +31 (0)6 50 50 49 80
                </a>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-dark mb-1">E-mail</h3>
                <div class="space-y-1">
                  <a href="mailto:info@bmaservices.nl" class="text-gray-500 hover:text-primary transition-colors block">
                    info@bmaservices.nl
                  </a>
                  <a href="mailto:raoul@bmaservices.nl" class="text-gray-500 hover:text-primary transition-colors block">
                    raoul@bmaservices.nl
                  </a>
                </div>
              </div>
            </div>

            <!-- Address -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-bold text-dark mb-1">Adres</h3>
                <p class="text-gray-500">
                  Zuid Afrikaweg 12 F<br />
                  1432 DA Aalsmeer
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- Contact Form -->
        <div class="bg-gray-light rounded-2xl p-8 md:p-10">
          <h3 class="text-2xl font-bold text-dark mb-6">Stuur ons een bericht</h3>
          <form action="#" method="POST" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-semibold text-dark mb-2">Naam</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white"
                placeholder="Uw naam"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-dark mb-2">E-mailadres</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white"
                placeholder="uw@email.nl"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-dark mb-2">Telefoonnummer</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white"
                placeholder="+31 6 12345678"
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-semibold text-dark mb-2">Onderwerp</label>
              <select
                id="subject"
                name="subject"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white"
              >
                <option value="">Selecteer een onderwerp</option>
                <option value="artist-handling">Complete Artist Handling</option>
                <option value="vervoer">Artiestenvervoer</option>
                <option value="stagemanagement">Stagemanagement</option>
                <option value="shuttle">Shuttle Service</option>
                <option value="overig">Overig</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-dark mb-2">Bericht</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all bg-white resize-none"
                placeholder="Vertel ons over uw evenement..."
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-4 rounded-xl transition-all duration-300 hover:shadow-lg hover:shadow-primary/25"
            >
              Verstuur bericht
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Map -->
  <section class="h-96 bg-gray-200 relative">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2444.8!2d4.7578!3d52.2594!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c5e1e1e1e1e1e1%3A0x1234567890!2sZuid+Afrikaweg+12F%2C+1432+DA+Aalsmeer!5e0!3m2!1snl!2snl!4v1"
      class="w-full h-full border-0"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      title="Locatie van BMA Services op de kaart - Zuid Afrikaweg 12 F, Aalsmeer"
    ></iframe>
  </section>

  <ClientLogos compact />

  <Footer />
</Layout>
